                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; AssemblerApplication2.asm
                                 ;
                                 ; Created: 10/10/2026 14:32:18
                                 ; Author : Asus
                                 ;
                                 
                                 
                                 ; Replace with your application code
                                 ;start:
                                     ;inc r16
                                    ; rjmp start
                                 
                                 
                                 
                                 	;=====================================================================
                                 ; IE3064 - Smart Traffic Junction Controller
                                 ; Target    : Arduino Uno (ATmega328P, 16 MHz)
                                 ; Tool      : Microchip Studio 7 - AVR Assembler project (AVRASM2)
                                 ; Language  : AVR Assembly only (no C, no C++, no Arduino library)
                                 ;
                                 ; Direct translation of the C++ prototype:
                                 ;   millis()        -> Timer1 compare-match interrupt every 1 ms
                                 ;   digitalRead     -> pin-change interrupt on PD7 + 30 ms debounce
                                 ;   analogRead      -> direct ADC register access (ADC5)
                                 ;   digitalWrite    -> whole-port writes (PORTB / PORTC / PORTD)
                                 ;   timing values   -> tables in program memory, read with LPM
                                 ;   Serial          -> not used (calibrate the LDR with the C++ version)
                                 ;
                                 ; PIN MAP
                                 ;   PB0 D8  NS red      PB3 D11 EW red
                                 ;   PB1 D9  NS yellow   PB4 D12 EW yellow
                                 ;   PB2 D10 NS green    PB5 D13 EW green
                                 ;   PD7 D7  pedestrian button to GND (internal pull-up, PCINT23)
                                 ;   PC0 A0  pedestrian red      PC1 A1 pedestrian green
                                 ;   PC3 A3  segment a           PC2 A2 segment b
                                 ;   PD2..PD6 (D2..D6) segments c,d,e,f,g   (common anode: 0 = ON)
                                 ;   PC4 A4  buzzer (1k resistor to BC547 base)
                                 ;   PC5 A5  ADC5 LDR divider: 5V - LDR - A5 - 10k - GND
                                 ;=====================================================================
                                 
                                 .include "m328pdef.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;---------------- light patterns written to PORTB --------------------
                                 ; bit: 5=EW_G 4=EW_Y 3=EW_R 2=NS_G 1=NS_Y 0=NS_R
                                 .equ L_NS_GO    = 0x0C          ; NS green  + EW red
                                 .equ L_NS_YEL   = 0x0A          ; NS yellow + EW red
                                 .equ L_ALL_RED  = 0x09          ; NS red    + EW red
                                 .equ L_EW_GO    = 0x21          ; EW green  + NS red
                                 .equ L_EW_YEL   = 0x11          ; EW yellow + NS red
                                 .equ L_NIGHT    = 0x12          ; NS yellow + EW yellow
                                 
                                 ;---------------- states (same numbers as the C++ enum) --------------
                                 .equ NS_READY    = 0
                                 .equ NS_GO       = 1
                                 .equ NS_STOPPING = 2
                                 .equ AFTER_NS    = 3
                                 .equ EW_READY    = 4
                                 .equ EW_GO       = 5
                                 .equ EW_STOPPING = 6
                                 .equ AFTER_EW    = 7
                                 .equ PEDESTRIAN  = 8
                                 
                                 ;---------------- constants ------------------------------------------
                                 .equ NIGHT_THRESHOLD = 400      ; 10-bit ADC: <= 400 means dark
                                 .equ RECOVERY_TIME   = 5000     ; ms of continuous light to leave night
                                 .equ FLASH_INTERVAL  = 500      ; 500 ms on + 500 ms off = 1 Hz
                                 .equ DEBOUNCE_TIME   = 30       ; ms
                                 .equ ONE_SECOND      = 1000     ; ms
                                 
                                 ;=====================================================================
                                 ; VARIABLES IN SRAM
                                 ;=====================================================================
                                 .dseg
                                 .org SRAM_START
000100                           v_ticks:     .byte 1            ; 1 ms ticks waiting (written by ISR)
000101                           v_debounce:  .byte 1            ; ms until button is stable (ISR)
000102                           v_btnCheck:  .byte 1            ; 1 = button stable, check it (ISR)
000103                           v_stable:    .byte 1            ; accepted button level (0x80 = up)
000104                           v_state:     .byte 1            ; current state 0..8
000105                           v_resume:    .byte 1            ; state to continue after crossing
000106                           v_request:   .byte 1            ; pedestrian request flag
000107                           v_nightMode: .byte 1            ; 1 = night mode
000108                           v_showZero:  .byte 1            ; show "0" during the READY state
000109                           v_stateMs:   .byte 2            ; ms spent in current state (16-bit)
00010b                           v_nightMs:   .byte 2            ; flash timer 0..999 (16-bit)
00010d                           v_recovMs:   .byte 2            ; continuous light time (16-bit)
00010f                           v_ldr:       .byte 2            ; last ADC reading (16-bit)
                                 v_end:
                                 
                                 ;=====================================================================
                                 ; INTERRUPT VECTORS
                                 ;=====================================================================
                                 .cseg
                                 .org 0x0000
000000 940c 0047                         jmp  RESET_HANDLER      ; reset
                                 .org PCI2addr
00000a 940c 00b8                         jmp  ISR_PCINT2         ; pin change on PORTD (button)
                                 .org OC1Aaddr
000016 940c 009f                         jmp  ISR_T1_COMPA       ; Timer1 compare A (1 ms)
                                 .org INT_VECTORS_SIZE           ; program starts after the vector table
                                 
                                 ;=====================================================================
                                 ; PROGRAM-MEMORY TABLES  (address * 2 because LPM uses byte addresses)
                                 ;=====================================================================
                                 ; PORTB light pattern for each state (last 0 = padding to even size)
                                 STATE_LIGHTS:
000034 0c0a
000035 090a                              .db L_NS_YEL,  L_NS_GO,  L_NS_YEL,  L_ALL_RED   ; 0..3
000036 2111
000037 0911                              .db L_EW_YEL,  L_EW_GO,  L_EW_YEL,  L_ALL_RED   ; 4..7
000038 0009                              .db L_ALL_RED, 0                                ; 8
                                 
                                 ; Duration of each state in ms
                                 STATE_TIME:
000039 03e8                              .dw 1000                ; 0 NS_READY     (READY_TIME)
00003a 2710                              .dw 10000               ; 1 NS_GO        (GREEN_TIME)
00003b 0bb8                              .dw 3000                ; 2 NS_STOPPING  (YELLOW_TIME)
00003c 03e8                              .dw 1000                ; 3 AFTER_NS     (ALL_RED_TIME)
00003d 03e8                              .dw 1000                ; 4 EW_READY
00003e 2710                              .dw 10000               ; 5 EW_GO
00003f 0bb8                              .dw 3000                ; 6 EW_STOPPING
000040 03e8                              .dw 1000                ; 7 AFTER_EW
000041 1388                              .dw 5000                ; 8 PEDESTRIAN   (PED_TIME)
                                 
                                 ; 7-segment font for digits 0..9: bit0=a ... bit6=g, 1 = segment lit
                                 ; (kept on ONE line: AVRASM pads every .db line to an even byte count)
                                 SEG_FONT:
000042 063f
000043 4f5b
000044 6d66
000045 077d
000046 6f7f                              .db 0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F
                                 
                                 ;=====================================================================
                                 ; RESET / SETUP
                                 ;=====================================================================
                                 RESET_HANDLER:
000047 94f8                              cli
000048 e008                              ldi  r16, HIGH(RAMEND)          ; stack pointer = top of SRAM
000049 bf0e                              out  SPH, r16
00004a ef0f                              ldi  r16, LOW(RAMEND)
00004b bf0d                              out  SPL, r16
00004c 2411                              clr  r1                         ; r1 is always 0
                                 
                                         ; ---- clear all variables ----
00004d e0a0                              ldi  XL, LOW(v_ticks)
00004e e0b1                              ldi  XH, HIGH(v_ticks)
00004f e101                              ldi  r16, v_end - v_ticks
                                 CLEAR_VARS:
000050 921d                              st   X+, r1
000051 950a                              dec  r16
000052 f7e9                              brne CLEAR_VARS
                                 
                                         ; ---- PORTB: six traffic outputs ----
000053 e30f                              ldi  r16, 0x3F
000054 b904                              out  DDRB, r16
000055 e00c                              ldi  r16, L_NS_GO
000056 b905                              out  PORTB, r16
                                 
                                         ; ---- PORTC: PC0..PC4 outputs, PC5 (LDR) input ----
000057 e10f                              ldi  r16, 0x1F
000058 b907                              out  DDRC, r16
000059 e00d                              ldi  r16, 0x0D                  ; ped red ON, seg a,b OFF, buzzer OFF
00005a b908                              out  PORTC, r16
                                 
                                         ; ---- PORTD: PD2..PD6 segments out, PD7 button in + pull-up ----
00005b e70c                              ldi  r16, 0x7C
00005c b90a                              out  DDRD, r16
00005d ef0c                              ldi  r16, 0xFC                  ; segments OFF, pull-up on PD7
00005e b90b                              out  PORTD, r16
                                 
                                         ; ---- ADC: AVcc reference, right adjusted, channel ADC5 ----
00005f e405                              ldi  r16, (1<<REFS0) | 5
000060 9300 007c                         sts  ADMUX, r16
000062 e807                              ldi  r16, (1<<ADEN) | (1<<ADPS2) | (1<<ADPS1) | (1<<ADPS0)
000063 9300 007a                         sts  ADCSRA, r16                ; enable, 16 MHz / 128 = 125 kHz
000065 e200                              ldi  r16, (1<<ADC5D)
000066 9300 007e                         sts  DIDR0, r16                 ; digital input off on ADC5
                                 
                                         ; ---- Timer1: CTC, 16 MHz / 64 / (249+1) = 1000 Hz ----
000068 9210 0080                         sts  TCCR1A, r1
00006a 9210 0085                         sts  TCNT1H, r1                 ; 16-bit write: high byte first
00006c 9210 0084                         sts  TCNT1L, r1
00006e 9210 0089                         sts  OCR1AH, r1
000070 ef09                              ldi  r16, 249
000071 9300 0088                         sts  OCR1AL, r16
000073 e00b                              ldi  r16, (1<<WGM12) | (1<<CS11) | (1<<CS10)
000074 9300 0081                         sts  TCCR1B, r16
000076 e002                              ldi  r16, (1<<OCIE1A)
000077 9300 006f                         sts  TIMSK1, r16
                                 
                                         ; ---- Pin-change interrupt on PD7 (PCINT23) ----
000079 e800                              ldi  r16, (1<<PCINT23)
00007a 9300 006d                         sts  PCMSK2, r16
00007c e004                              ldi  r16, (1<<PCIF2)            ; clear old flag (write 1)
00007d bb0b                              out  PCIFR, r16
00007e e004                              ldi  r16, (1<<PCIE2)
00007f 9300 0068                         sts  PCICR, r16
                                 
                                         ; ---- same start as the C++ setup() ----
000081 d047                              rcall SYNC_BUTTON
000082 e001                              ldi  r16, NS_GO
000083 d03e                              rcall ENTER_STATE
000084 9478                              sei
                                 
                                 ;=====================================================================
                                 ; MAIN LOOP: run TICK_1MS once for every Timer1 tick
                                 ;=====================================================================
                                 MAIN_LOOP:
000085 9100 0100                         lds  r16, v_ticks
000087 2300                              tst  r16
000088 f3e1                              breq MAIN_LOOP
000089 94f8                              cli                             ; v_ticks is shared with the ISR
00008a 9100 0100                         lds  r16, v_ticks
00008c 950a                              dec  r16
00008d 9300 0100                         sts  v_ticks, r16
00008f 9478                              sei
000090 d001                              rcall TICK_1MS
000091 cff3                              rjmp MAIN_LOOP
                                 
                                 ;=====================================================================
                                 ; ONE MILLISECOND OF WORK 
                                 ;=====================================================================
                                 TICK_1MS:
000092 d06d                              rcall UPDATE_NIGHT_MODE
000093 9100 0107                         lds  r16, v_nightMode
000095 2300                              tst  r16
000096 f021                              breq TICK_NORMAL
000097 9210 0106                         sts  v_request, r1              ; night: ignore every request
000099 d02f                              rcall SYNC_BUTTON
00009a c002                              rjmp TICK_OUT
                                 TICK_NORMAL:
00009b d038                              rcall READ_BUTTON
00009c d09b                              rcall UPDATE_TRAFFIC
                                 TICK_OUT:
00009d d0d7                              rcall UPDATE_OUTPUTS
00009e 9508                              ret
                                 
                                 ;=====================================================================
                                 ; ISR: Timer1 compare A - every 1 ms
                                 ;=====================================================================
                                 ISR_T1_COMPA:
00009f 930f                              push r16
0000a0 b70f                              in   r16, SREG
0000a1 930f                              push r16
                                 
0000a2 9100 0100                         lds  r16, v_ticks               ; ticks++ (stop at 255)
0000a4 3f0f                              cpi  r16, 255
0000a5 f019                              breq T1_DEBOUNCE
0000a6 9503                              inc  r16
0000a7 9300 0100                         sts  v_ticks, r16
                                 T1_DEBOUNCE:
0000a9 9100 0101                         lds  r16, v_debounce            ; count debounce time down
0000ab 2300                              tst  r16
0000ac f039                              breq T1_DONE
0000ad 950a                              dec  r16
0000ae 9300 0101                         sts  v_debounce, r16
0000b0 f419                              brne T1_DONE
0000b1 e001                              ldi  r16, 1                     ; reached 0: pin quiet for 30 ms
0000b2 9300 0102                         sts  v_btnCheck, r16
                                 T1_DONE:
0000b4 910f                              pop  r16
0000b5 bf0f                              out  SREG, r16
0000b6 910f                              pop  r16
0000b7 9518                              reti
                                 
                                 ;=====================================================================
                                 ; ISR: pin change on PD7 - restart the debounce timer
                                 ;=====================================================================
                                 ISR_PCINT2:
0000b8 930f                              push r16
0000b9 b70f                              in   r16, SREG
0000ba 930f                              push r16
0000bb e10e                              ldi  r16, DEBOUNCE_TIME
0000bc 9300 0101                         sts  v_debounce, r16
0000be 910f                              pop  r16
0000bf bf0f                              out  SREG, r16
0000c0 910f                              pop  r16
0000c1 9518                              reti
                                 
                                 ;=====================================================================
                                 ; ENTER_STATE: r16 = new state   (state = r16, stateMs = 0)
                                 ;=====================================================================
                                 ENTER_STATE:
0000c2 9300 0104                         sts  v_state, r16
0000c4 9210 0109                         sts  v_stateMs, r1
0000c6 9210 010a                         sts  v_stateMs+1, r1
0000c8 9508                              ret
                                 
                                 ;=====================================================================
                                 ; SYNC_BUTTON: accept current pin level, cancel pending debounce
                                 ;=====================================================================
                                 SYNC_BUTTON:
0000c9 94f8                              cli
0000ca b109                              in   r16, PIND
0000cb 7800                              andi r16, (1<<PIND7)            ; 0x80 = released, 0 = pressed
0000cc 9300 0103                         sts  v_stable, r16
0000ce 9210 0101                         sts  v_debounce, r1
0000d0 9210 0102                         sts  v_btnCheck, r1
0000d2 9478                              sei
0000d3 9508                              ret
                                 
                                 ;=====================================================================
                                 ; READ_BUTTON: called in NORMAL mode only
                                 ;=====================================================================
                                 READ_BUTTON:
0000d4 94f8                              cli                             ; take and clear the ISR flag
0000d5 9100 0102                         lds  r16, v_btnCheck
0000d7 9210 0102                         sts  v_btnCheck, r1
0000d9 9478                              sei
0000da 2300                              tst  r16
0000db f089                              breq RB_DONE
                                 
0000dc b109                              in   r16, PIND
0000dd 7800                              andi r16, (1<<PIND7)
0000de 9110 0103                         lds  r17, v_stable
0000e0 1701                              cp   r16, r17
0000e1 f059                              breq RB_DONE                    ; level did not change
0000e2 9300 0103                         sts  v_stable, r16
0000e4 2300                              tst  r16
0000e5 f439                              brne RB_DONE                    ; it was a release
                                 
0000e6 9110 0104                         lds  r17, v_state               ; pressed: ignore during crossing
0000e8 3018                              cpi  r17, PEDESTRIAN
0000e9 f019                              breq RB_DONE
0000ea e011                              ldi  r17, 1
0000eb 9310 0106                         sts  v_request, r17             ; one flag = one crossing
                                 RB_DONE:
0000ed 9508                              ret
                                 
                                 ;=====================================================================
                                 ; READ_LDR: r25:r24 = 10-bit reading of ADC5
                                 ;=====================================================================
                                 READ_LDR:
0000ee 9100 007a                         lds  r16, ADCSRA
0000f0 6400                              ori  r16, (1<<ADSC)             ; start conversion
0000f1 9300 007a                         sts  ADCSRA, r16
                                 RL_WAIT:
0000f3 9100 007a                         lds  r16, ADCSRA
0000f5 fd06                              sbrc r16, ADSC                  ; wait until ADSC returns to 0
0000f6 cffc                              rjmp RL_WAIT
0000f7 9180 0078                         lds  r24, ADCL                  ; ADCL must be read first
0000f9 9190 0079                         lds  r25, ADCH
0000fb 9380 010f                         sts  v_ldr, r24
0000fd 9390 0110                         sts  v_ldr+1, r25
0000ff 9508                              ret
                                 
                                 ;=====================================================================
                                 ; UPDATE_NIGHT_MODE
                                 ;=====================================================================
                                 UPDATE_NIGHT_MODE:
000100 dfed                              rcall READ_LDR
000101 e901                              ldi  r16, LOW(NIGHT_THRESHOLD+1)
000102 e011                              ldi  r17, HIGH(NIGHT_THRESHOLD+1)
000103 1780                              cp   r24, r16
000104 0791                              cpc  r25, r17
000105 f4a0                              brsh UN_LIGHT                   ; reading >= 401 -> light
                                 
                                         ; ---------- DARK ----------
000106 9210 010d                         sts  v_recovMs, r1              ; any dark sample restarts recovery
000108 9210 010e                         sts  v_recovMs+1, r1
00010a 9100 0107                         lds  r16, v_nightMode
00010c 2300                              tst  r16
00010d f549                              brne UN_DONE                    ; already night
00010e e001                              ldi  r16, 1                     ; enter night mode
00010f 9300 0107                         sts  v_nightMode, r16
000111 9210 010b                         sts  v_nightMs, r1
000113 9210 010c                         sts  v_nightMs+1, r1
000115 9210 0106                         sts  v_request, r1
000117 9210 0108                         sts  v_showZero, r1
000119 9508                              ret
                                 
                                         ; ---------- LIGHT ----------
                                 UN_LIGHT:
00011a 9100 0107                         lds  r16, v_nightMode
00011c 2300                              tst  r16
00011d f0c9                              breq UN_DONE                    ; already normal
00011e 9180 010d                         lds  r24, v_recovMs             ; recovMs++
000120 9190 010e                         lds  r25, v_recovMs+1
000122 9601                              adiw r24, 1
000123 9380 010d                         sts  v_recovMs, r24
000125 9390 010e                         sts  v_recovMs+1, r25
000127 e808                              ldi  r16, LOW(RECOVERY_TIME)
000128 e113                              ldi  r17, HIGH(RECOVERY_TIME)
000129 1780                              cp   r24, r16
00012a 0791                              cpc  r25, r17
00012b f058                              brlo UN_DONE                    ; less than 5 s of light
                                 
00012c 9210 0107                         sts  v_nightMode, r1            ; leave night mode
00012e 9210 010d                         sts  v_recovMs, r1
000130 9210 010e                         sts  v_recovMs+1, r1
000132 9210 0106                         sts  v_request, r1
000134 df94                              rcall SYNC_BUTTON               ; ignore a button held at night
000135 e007                              ldi  r16, AFTER_EW              ; all-red, then NS_READY, NS_GO
000136 df8b                              rcall ENTER_STATE
                                 UN_DONE:
000137 9508                              ret
                                 
                                 ;=====================================================================
                                 ; UPDATE_TRAFFIC: state machine for NORMAL mode
                                 ;=====================================================================
                                 UPDATE_TRAFFIC:
000138 9180 0109                         lds  r24, v_stateMs             ; stateMs++
00013a 9190 010a                         lds  r25, v_stateMs+1
00013c 9601                              adiw r24, 1
00013d 9380 0109                         sts  v_stateMs, r24
00013f 9390 010a                         sts  v_stateMs+1, r25
                                 
000141 9100 0104                         lds  r16, v_state               ; Z = STATE_TIME + 2*state
000143 e7e2                              ldi  ZL, LOW(STATE_TIME*2)
000144 e0f0                              ldi  ZH, HIGH(STATE_TIME*2)
000145 2f10                              mov  r17, r16
000146 0f11                              lsl  r17
000147 0fe1                              add  ZL, r17
000148 1df1                              adc  ZH, r1
000149 9165                              lpm  r22, Z+                    ; r23:r22 = duration
00014a 9174                              lpm  r23, Z
00014b 1786                              cp   r24, r22
00014c 0797                              cpc  r25, r23
00014d f130                              brlo UT_DONE                    ; time not finished
                                 
                                         ; ---- time is up: choose next state ----
00014e 3008                              cpi  r16, PEDESTRIAN
00014f f0c1                              breq UT_PED_END
000150 3003                              cpi  r16, AFTER_NS
000151 f051                              breq UT_CLEARANCE
000152 3007                              cpi  r16, AFTER_EW
000153 f041                              breq UT_CLEARANCE
000154 3000                              cpi  r16, NS_READY
000155 f019                              breq UT_READY_END
000156 3004                              cpi  r16, EW_READY
000157 f009                              breq UT_READY_END
000158 c018                              rjmp UT_NEXT
                                 
                                 UT_READY_END:
000159 9210 0108                         sts  v_showZero, r1             ; "0" disappears when green starts
00015b c015                              rjmp UT_NEXT
                                 
                                 UT_CLEARANCE:
00015c 9110 0106                         lds  r17, v_request
00015e 2311                              tst  r17
00015f f089                              breq UT_NEXT                    ; no request: continue normally
000160 9210 0106                         sts  v_request, r1              ; request served
000162 9503                              inc  r16                        ; resume = next state
000163 7007                              andi r16, 0x07                  ; (3 -> 4, 7 -> 0)
000164 9300 0105                         sts  v_resume, r16
000166 e008                              ldi  r16, PEDESTRIAN
000167 cf5a                              rjmp ENTER_STATE                ; tail call
                                 
                                 UT_PED_END:
000168 9210 0106                         sts  v_request, r1
00016a df5e                              rcall SYNC_BUTTON
00016b e001                              ldi  r16, 1
00016c 9300 0108                         sts  v_showZero, r16
00016e 9100 0105                         lds  r16, v_resume
000170 cf51                              rjmp ENTER_STATE
                                 
                                 UT_NEXT:                                ; next = (state + 1) mod 8
000171 9503                              inc  r16
000172 7007                              andi r16, 0x07
000173 cf4e                              rjmp ENTER_STATE
                                 UT_DONE:
000174 9508                              ret
                                 
                                 ;=====================================================================
                                 ; UPDATE_OUTPUTS: PORTB, PORTC, PORTD
                                 ;   r20 = segment pattern (1 = lit), r21 = PORTC bits PC0/PC1/PC4
                                 ;=====================================================================
                                 UPDATE_OUTPUTS:
000175 9100 0107                         lds  r16, v_nightMode
000177 2300                              tst  r16
000178 f0c9                              breq UO_NORMAL
                                 
                                         ; ---------- NIGHT: flash yellows, all else off ----------
000179 9180 010b                         lds  r24, v_nightMs
00017b 9190 010c                         lds  r25, v_nightMs+1
00017d e102                              ldi  r16, L_NIGHT
00017e e011                              ldi  r17, HIGH(FLASH_INTERVAL)
00017f 3f84                              cpi  r24, LOW(FLASH_INTERVAL)
000180 0791                              cpc  r25, r17
000181 f008                              brlo UO_FLASH                   ; first 500 ms: ON
000182 2700                              clr  r16                        ; second 500 ms: OFF
                                 UO_FLASH:
000183 b905                              out  PORTB, r16
000184 9601                              adiw r24, 1                     ; nightMs = (nightMs+1) mod 1000
000185 e013                              ldi  r17, HIGH(2*FLASH_INTERVAL)
000186 3e88                              cpi  r24, LOW(2*FLASH_INTERVAL)
000187 0791                              cpc  r25, r17
000188 f010                              brlo UO_STORE
000189 2788                              clr  r24
00018a 2799                              clr  r25
                                 UO_STORE:
00018b 9380 010b                         sts  v_nightMs, r24
00018d 9390 010c                         sts  v_nightMs+1, r25
00018f 2744                              clr  r20                        ; display blank
000190 2755                              clr  r21                        ; ped LEDs off, buzzer off
000191 c02b                              rjmp WRITE_DISPLAY
                                 
                                         ; ---------- NORMAL / PEDESTRIAN ----------
                                 UO_NORMAL:
000192 9100 0104                         lds  r16, v_state
000194 e6e8                              ldi  ZL, LOW(STATE_LIGHTS*2)    ; PORTB = STATE_LIGHTS[state]
000195 e0f0                              ldi  ZH, HIGH(STATE_LIGHTS*2)
000196 0fe0                              add  ZL, r16
000197 1df1                              adc  ZH, r1
000198 9114                              lpm  r17, Z
000199 b915                              out  PORTB, r17
                                 
00019a 3008                              cpi  r16, PEDESTRIAN
00019b f4a1                              brne UO_NOT_CROSSING
                                 
                                         ; crossing: ped green + buzzer, digit = 5 - (stateMs / 1000)
00019c e152                              ldi  r21, (1<<PC1) | (1<<PC4)
00019d e025                              ldi  r18, 5
00019e 9180 0109                         lds  r24, v_stateMs
0001a0 9190 010a                         lds  r25, v_stateMs+1
                                 UO_DIV:
0001a2 e013                              ldi  r17, HIGH(ONE_SECOND)
0001a3 3e88                              cpi  r24, LOW(ONE_SECOND)
0001a4 0791                              cpc  r25, r17
0001a5 f020                              brlo UO_DIGIT
0001a6 5e88                              subi r24, LOW(ONE_SECOND)
0001a7 4093                              sbci r25, HIGH(ONE_SECOND)
0001a8 952a                              dec  r18
0001a9 cff8                              rjmp UO_DIV
                                 UO_DIGIT:
0001aa e8e4                              ldi  ZL, LOW(SEG_FONT*2)        ; r20 = SEG_FONT[digit]
0001ab e0f0                              ldi  ZH, HIGH(SEG_FONT*2)
0001ac 0fe2                              add  ZL, r18
0001ad 1df1                              adc  ZH, r1
0001ae 9144                              lpm  r20, Z
0001af c00d                              rjmp WRITE_DISPLAY
                                 
                                 UO_NOT_CROSSING:
0001b0 e051                              ldi  r21, (1<<PC0)              ; ped red ON
0001b1 2744                              clr  r20                        ; blank unless "0" is needed
0001b2 9110 0108                         lds  r17, v_showZero
0001b4 2311                              tst  r17
0001b5 f039                              breq WRITE_DISPLAY
0001b6 3000                              cpi  r16, NS_READY
0001b7 f011                              breq UO_ZERO
0001b8 3004                              cpi  r16, EW_READY
0001b9 f419                              brne WRITE_DISPLAY
                                 UO_ZERO:
0001ba e8e4                              ldi  ZL, LOW(SEG_FONT*2)
0001bb e0f0                              ldi  ZH, HIGH(SEG_FONT*2)
0001bc 9144                              lpm  r20, Z                     ; pattern for "0"
                                 
                                         ; ---------- send r20 / r21 to the pins ----------
                                 WRITE_DISPLAY:
0001bd 2f34                              mov  r19, r20
0001be 9530                              com  r19                        ; common anode: 1 = segment OFF
0001bf b10b                              in   r16, PORTD                 ; c..g = bits 2..6 = PD2..PD6
0001c0 7803                              andi r16, 0x83                  ; keep PD0, PD1, PD7 (pull-up)
0001c1 2f13                              mov  r17, r19
0001c2 771c                              andi r17, 0x7C
0001c3 2b01                              or   r16, r17
0001c4 b90b                              out  PORTD, r16
0001c5 fd31                              sbrc r19, 1                     ; segment b -> PC2
0001c6 6054                              ori  r21, (1<<PC2)
0001c7 fd30                              sbrc r19, 0                     ; segment a -> PC3
0001c8 6058                              ori  r21, (1<<PC3)
0001c9 b958                              out  PORTC, r21                 ; PC5 stays 0 (LDR input)
0001ca 9508                              ret


